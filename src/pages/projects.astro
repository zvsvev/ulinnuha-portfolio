---
import DeviceFrame from '../layouts/DeviceFrame.astro';
import AppScreen from '../components/AppScreen.astro';
import { projects } from '../data/projects.ts';
---

<DeviceFrame title="Projects" desc="Projects by Muhammad Ulinnuha.">
  <AppScreen title="Projects" backTo="/" />

  <div class="projects-list">
    {projects.map((p, i) => (
      <a class="project-row" href={p.href ?? `/projects/${p.slug}`} style={`animation-delay:${i * 0.05}s`}>
        <span class="project-face" aria-hidden="true">
          <span class="project-emoji">{p.emoji}</span>
          <span class="app-glass"></span>
        </span>
        <span class="project-body">
          <span class="project-title">{p.title}</span>
          <span class="project-desc">{p.description}</span>
          <span class="project-tags">
            {p.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
          </span>
        </span>
        <span class="chevron">›</span>
      </a>
    ))}
  </div>

  <p class="more-note">More projects on <a href="https://github.com/zvsvev" target="_blank" rel="noopener">GitHub</a>.</p>
</DeviceFrame>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
  }
  .project-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: rgba(255,255,255,0.92);
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.12);
    text-decoration: none;
    animation: row-in 0.35s ease backwards;
  }
  @keyframes row-in {
    from { opacity: 0; transform: translateX(-12px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .project-face {
    position: relative;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--ios-blue-grad);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    box-shadow: 0 1px 0 rgba(255,255,255,0.35) inset, 0 -1px 1px rgba(0,0,0,0.28) inset, 0 2px 4px rgba(0,0,0,0.3);
    overflow: hidden;
  }
  .project-emoji { filter: drop-shadow(0 1px 1px rgba(0,0,0,0.25)); }
  .project-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .project-title { font-size: 14px; font-weight: 700; color: #1a1a1a; }
  .project-desc {
    font-size: 11.5px;
    color: #666;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-tags { display: flex; gap: 4px; margin-top: 3px; flex-wrap: wrap; }
  .tag {
    font-size: 9.5px;
    font-weight: 600;
    color: var(--ios-blue-dark);
    background: #e3ecfa;
    border-radius: 4px;
    padding: 1px 6px;
  }
  .chevron { color: #c7c7cc; font-size: 18px; }
  .more-note {
    text-align: center;
    font-size: 12px;
    color: rgba(255,255,255,0.85);
    text-shadow: 0 1px 2px rgba(0,0,0,0.4);
    padding-bottom: 16px;
  }
  .more-note a { text-decoration: underline; }
</style>
