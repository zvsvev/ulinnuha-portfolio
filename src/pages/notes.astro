---
import DeviceFrame from '../layouts/DeviceFrame.astro';
import AppScreen from '../components/AppScreen.astro';
---

<DeviceFrame title="Notes" desc="Notes — ulinnuha.">
  <AppScreen title="Notes" backTo="/" />

  <div class="notes-list">
    <article class="note-card">
      <h2>How this site works</h2>
      <p>
        The whole portfolio is an old iPhone. Unlock it, tap around. Built with Astro + React
        on Cloudflare Pages — no servers, just vibes.
      </p>
      <time>Yesterday</time>
    </article>

    <article class="note-card">
      <h2>Currently</h2>
      <p>
        Freelance + full-time opportunities open. Building on Solana, tinkering with C,
        vibecoding everything else.
      </p>
      <time>This week</time>
    </article>

    <article class="note-card">
      <h2>Favorite tools</h2>
      <p>Go, Vue, React, Node, PostgreSQL, Solidity, C/C++, Redis, Tailwind.</p>
      <time>Always</time>
    </article>
  </div>
</DeviceFrame>

<style>
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
  }
  .note-card {
    background: rgba(255,255,255,0.94);
    border-radius: 10px;
    padding: 12px 14px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.12);
  }
  .note-card h2 { font-size: 14px; margin-bottom: 4px; color: #1a1a1a; }
  .note-card p { font-size: 12.5px; line-height: 1.45; color: #444; }
  .note-card time {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    color: #999;
    border-top: 1px solid #ececec;
    padding-top: 6px;
  }
</style>
