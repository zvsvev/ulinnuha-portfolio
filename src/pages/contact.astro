---
import DeviceFrame from '../layouts/DeviceFrame.astro';
import AppScreen from '../components/AppScreen.astro';
import { socials, contact } from '../data/contact.ts';
---

<DeviceFrame title="Contacts" desc="Contact Muhammad Ulinnuha.">
  <AppScreen title="Contacts" backTo="/" />

  <div class="contact-hero">
    <div class="contact-avatar">🧑‍💻</div>
    <h1>Muhammad Ulinnuha</h1>
    <p class="contact-status">Available for work</p>
  </div>

  <div class="list-group">
    <a class="list-row" href={`mailto:${contact.email}`}>
      <span class="row-emoji">📧</span>
      <span class="row-label">Email</span>
      <span class="row-value">{contact.email}</span>
    </a>
    <a class="list-row" href={contact.telegram} target="_blank" rel="noopener">
      <span class="row-emoji">✈️</span>
      <span class="row-label">Telegram</span>
      <span class="chevron">›</span>
    </a>
    <a class="list-row" href={contact.github} target="_blank" rel="noopener">
      <span class="row-emoji">🐙</span>
      <span class="row-label">GitHub</span>
      <span class="chevron">›</span>
    </a>
    {socials.filter(s => !['Telegram', 'GitHub'].includes(s.label)).map((s) => (
      <a class="list-row" href={s.href} target="_blank" rel="noopener">
        <span class="row-emoji">{s.emoji}</span>
        <span class="row-label">{s.label}</span>
        <span class="chevron">›</span>
      </a>
    ))}
  </div>

  <div style="padding: 14px; text-align:center;">
    <a class="ios-btn green" href={`mailto:${contact.email}`}>✉️ Send an email</a>
  </div>
</DeviceFrame>

<style>
  .contact-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 30px 14px 18px;
  }
  .contact-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: linear-gradient(180deg, #6ea5ff, #2f7be8);
    box-shadow: 0 2px 6px rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
  }
  .contact-hero h1 {
    font-size: 18px;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }
  .contact-status {
    font-size: 13px;
    color: #d7f5c8;
    text-shadow: 0 1px 2px rgba(0,0,0,0.4);
  }
  .row-emoji { font-size: 16px; width: 22px; text-align: center; }
  .row-value { font-size: 13px; color: var(--ios-text-secondary); }
  .chevron { color: #c7c7cc; font-size: 18px; }
</style>
