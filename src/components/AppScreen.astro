---
// AppScreen — the chrome around an "app" page: nav bar with back button.
// Props:
//   title   — nav bar title
//   backTo  — href for the back button (default: /)
//   action  — optional right-side action label
interface Props {
  title: string;
  backTo?: string;
  action?: string;
}

const { title, backTo = '/', action } = Astro.props;
---

<header class="app-nav">
  <a class="nav-back" href={backTo} aria-label="Back">◀ Home</a>
  <span class="nav-title">{title}</span>
  {action ? <a class="nav-action" href={backTo}>{action}</a> : <span class="nav-action"></span>}
</header>

<style>
  .app-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    background: var(--ios-blue-grad);
    border-bottom: 1px solid rgba(0,0,0,0.15);
    box-shadow: var(--ios-glass), 0 1px 0 rgba(255,255,255,0.25) inset;
  }
  .nav-back, .nav-action {
    min-width: 72px;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    background: none;
    border: none;
    text-shadow: 0 -1px 0 rgba(0,0,0,0.35);
    text-decoration: none;
  }
  .nav-back { text-align: left; }
  .nav-action { text-align: right; }
  .nav-title {
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-shadow: 0 -1px 0 rgba(0,0,0,0.35);
    text-align: center;
    flex: 1;
  }
</style>
