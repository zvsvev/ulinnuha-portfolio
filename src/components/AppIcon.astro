---
// AppIcon — skeuomorphic iOS app icon.
// Props:
//   emoji   — glyph shown on the icon face (or pass children)
//   label   — accessibility label + caption
//   href    — where it links
//   bg      — css background (gradient/color)
interface Props {
  emoji: string;
  label: string;
  href?: string;
  bg?: string;
}

const { emoji, label, href = '#', bg = 'linear-gradient(180deg,#6ea5ff,#2f7be8)' } = Astro.props;
---

<a class="appicon" href={href} aria-label={label}>
  <span class="appicon-face" style={`background:${bg}`} aria-hidden="true">
    <span class="appicon-emoji">{emoji}</span>
    <span class="appicon-glass"></span>
  </span>
  <span class="appicon-caption">{label}</span>
</a>

<style>
  .appicon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 68px;
    text-decoration: none;
    border-radius: 14px;
    padding: 4px;
    transition: transform 0.12s ease, filter 0.12s ease;
  }
  .appicon:active {
    transform: scale(0.92);
    filter: brightness(1.08);
  }
  .appicon-face {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.35) inset,
      0 -1px 1px rgba(0,0,0,0.28) inset,
      0 2px 4px rgba(0,0,0,0.35);
    overflow: hidden;
  }
  .appicon-glass {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0.08) 42%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
    border-radius: inherit;
    pointer-events: none;
  }
  .appicon-emoji {
    filter: drop-shadow(0 1px 1px rgba(0,0,0,0.25));
  }
  .appicon-caption {
    font-size: 10.5px;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.7);
    text-align: center;
    line-height: 1.15;
    max-width: 68px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
