---
// DeviceFrame.astro — the iPhone shell (single page).
// Props:
//   title    — page <title>
//   desc     — meta description
import '../styles/global.css';
import StatusBar from '../components/StatusBar.tsx';

interface Props {
  title: string;
  desc?: string;
}

const { title, desc } = Astro.props;
const pageTitle = title.includes('ulinnuha') ? title : `${title} — ulinnuha.eth`;
const descAttr = desc ?? 'ulinnuha.eth — software engineer & vibecoder. Web apps, smart contracts, and the occasional game, inside an unlockable retro iPhone.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descAttr} />
    <meta name="theme-color" content="#1b1b1b" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('ulinnuha.theme');
          if (theme !== 'dark' && theme !== 'light') {
            theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
          var lang = localStorage.getItem('ulinnuha.lang');
          if (lang === 'id' || lang === 'en') document.documentElement.lang = lang;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="page-backdrop" aria-hidden="true"></div>

    <main class="device">
      <div class="device-inner">
        <StatusBar client:load />

        <!-- The phone "screen" content -->
        <div class="screen">
          <slot />
        </div>
      </div>

      <!-- Home indicator -->
      <div class="home-indicator" aria-hidden="true"></div>
    </main>
  </body>
</html>
